# .lycheeignore
# One pattern per line, treated as regex matched against the full URL.

# Tango Card API examples with placeholder credentials/identifiers --
# these paths contain literal placeholder segments and will never resolve
https://integration-api\.tangocard\.com/raas/v2/accounts/.*
https://integration-api\.tangocard\.com/raas/v2/catalogs/.*
https://integration-api\.tangocard\.com/raas/v2/available.*
https://integration-api\.tangocard\.com/raas/v2/orders.*

# Localhost / mock server -- used by validate-curl-against-mock.sh
http://127\.0\.0\.1.*
http://localhost.*

# Generic placeholder domains used in code samples and docs prose
https://example\.com.*
https://your-domain\.com.*

# Stripe API host is checked live inside validate-curl-against-mock.sh
# against the mock server, not by lychee
https://api\.stripe\.com.*

# mailto: links
^mailto:.*

# Anchor-only links
^#.*
